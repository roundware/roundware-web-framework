{
  "include": [
    "src",
    "./index.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ],
  "compilerOptions": {
    "outDir": "./dist/",
    "rootDir": "./src",
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": [
      "ES2017",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "isolatedModules": true,
    "esModuleInterop": true
  }
}