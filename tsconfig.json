{
  "include": [
    "src",
    "./index.d.ts"
  ],
  "compilerOptions": {
    "outDir": "./dist/",
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "lib": [
      "ES6",
      "DOM"
    ],
    "skipLibCheck": true,
    // Ensure that .d.ts files are created by tsc, but not .js files
    "declaration": true,
    // Ensure that Babel can safely transpile files in the TypeScript project
    "isolatedModules": true,
    "esModuleInterop": true
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}